import "pkg:/components/Services/DeArrow/DeArrowCell.bs"
import "pkg:/components/Services/DeArrow/DeArrowService.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.thumbnail = m.top.FindNode("thumbnail")
    m.titleLabel = m.top.FindNode("titleLabel")
    m.durationRect = m.top.FindNode("durationRect")
    m.durationLabel = m.top.FindNode("durationLabel")
    m.smallestSystemFont = m.top.FindNode("smallestSystemFont")
    m.smallestBoldSystemFont = m.top.FindNode("smallestBoldSystemFont")
    m.progressRect = m.top.FindNode("progressRect")
    m.dearrowIcon = m.top.FindNode("dearrowIcon")
end function

function OnContentSet() as void
    content = m.top.itemContent

    if content = invalid
        return
    end if

    m.top.title = content.title
    m.titleLabel.rawText = ValidString(content.title)
    lines = content.lines

    ' NOTE: "_author" not "author". See PlaylistContentNode.xml for explanation.
    author = content._author
    if StringUtils.IsNullOrEmpty(author)
        if IsArray(lines) and lines.Count() > 0
            author = lines[0]
        end if
    end if
    m.top.author = author

    viewCountDate = ""
    if content.isUpcoming = true
        viewCountDate = content.premiereTimestampText
    else
        publishedText = content.publishedText
        viewCountText = content.viewCountText

        label = publishedText
        if publishedText.Len() > 0 and viewCountText.Len() > 0
            label += " • "
        end if
        label += viewCountText

        viewCountDate = label
    end if
    if StringUtils.IsNullOrEmpty(viewCountDate)
        if IsArray(lines) and lines.Count() > 1
            viewCountDate = lines[1]
        end if
    end if
    m.top.viewCountDate = viewCountDate

    m.top.thumbnailUri = content.thumbnail

    m.top.percentDurationWatched = content.percentDurationWatched

    if not StringUtils.IsNullOrEmpty(content.lengthText)
        SetDurationLabel(content.lengthText, "#161616FF", 0.8, m.smallestSystemFont)
        m.top.durationRectVisible = true
    else
        if content.isUpcoming = true
            SetDurationLabel(Tr(Locale.RowCell.Upcoming), "#161616FF", 0.8, m.smallestBoldSystemFont)
            m.top.durationRectVisible = true
        else if content.liveNow
            SetDurationLabel(Tr(Locale.RowCell.Live), "#CC0000FF", 0.9, m.smallestBoldSystemFont)
            m.top.durationRectVisible = true
        else
            m.top.durationRectVisible = false
        end if
    end if

    DeArrowCell.HandleContentSet(m, content, FuncName(OnDeArrowChanged), FuncName(OnDeArrowJobDone))
    ApplyDeArrow()
end function

function OnDeArrowChanged(event as object) as void
    content = event.getRoSGNode()
    if m.top.itemContent = invalid or not m.top.itemContent.isSameNode(content)
        return
    end if
    ApplyDeArrow()
end function

function OnDeArrowJobDone(event as object) as void
    DeArrowCell.OnJobDone(m, event)
end function

' Re-projects the DeArrow fields the content node carries; runs both when the content is first set
' (possibly already resolved) and when a job answer lands.
function ApplyDeArrow() as void
    content = m.top.itemContent
    iconUri = DeArrowCell.IconUri(content, m.global)
    if m.dearrowIcon <> invalid
        m.dearrowIcon.visible = iconUri <> ""
        m.dearrowIcon.uri = iconUri
    end if
    if content = invalid or not content.hasField("dearrowState")
        return
    end if
    state = ValidString(content.dearrowState)
    if DeArrowCell.HasTitle(state)
        m.titleLabel.rawText = ValidString(content.title)
    end if
    if DeArrowCell.HasThumbnail(state)
        ' the community thumbnail goes in directly, the original stays as the poster's load fallback
        m.thumbnail.fallbackUri = ValidString(content.thumbnail)
        m.thumbnail.uri = ValidString(content.dearrowThumbnail)
    end if
end function

function SetDurationLabel(text as string, bgColor as string, bgOpacity as float, font as object) as void
    m.top.duration = text

    label = m.durationLabel
    rect = m.durationRect

    if label = invalid or rect = invalid
        return
    end if

    rectParent = rect.getParent()
    label.font = font

    size = label.localBoundingRect()

    rect.width = size.width + 16
    rect.translation = [rectParent.width - rect.width, rect.translation[1]]
    rect.color = bgColor
    rect.opacity = bgOpacity
end function

function OnPercentDurationWatched() as void
    if m.progressRect = invalid
        return
    end if

    percent = MathUtils.Clamp(m.top.percentDurationWatched, 0, 100) / 100.0
    m.progressRect.scale = [percent, 1]
end function
