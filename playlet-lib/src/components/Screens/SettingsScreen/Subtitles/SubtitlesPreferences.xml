<component name="SubtitlesPreferences" extends="Group" includes="AutoBind,Focus">
    <interface>
        <field id="preferences" type="node" onChange="OnPreferencesSet" />
        <field id="appController" type="node" bind="/AppController" />
    </interface>
    <children>
        <Rectangle
            width="1280"
            height="720"
            color="#000000"
            opacity="0.5">
        </Rectangle>
        <Rectangle
            width="720"
            height="600"
            translation="[300,60]"
            color="#242424">
            <Label
                width="720"
                horizAlign="center"
                translation="[0,38]"
                text="Subtitles">
                <Font role="font" uri="font:SystemFontFile" size="24" />
            </Label>

            <MarkupGrid
                id="settingList"
                itemComponentName="SubtitleSettingItem"
                itemSize="[640,32]"
                itemSpacing="[0,10]"
                numColumns="1"
                numRows="3"
                vertFocusAnimationStyle="floatingFocus"
                translation="[40,90]"
                focusBitmapUri="pkg:/images/focus-glow-padding-30.$$RES$$.9.png" />

            <ButtonEx
                id="closeButton"
                iconVisible="false"
                text="Close"
                padding="[30,30]"
                translation="[310,520]" />
        </Rectangle>
    </children>
</component>
