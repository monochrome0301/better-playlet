import "pkg:/components/Dialog/DialogUtils.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/parts/AutoBind/OnNodeReadyNoOp.bs"
import "pkg:/components/VideoPlayerDev/PlayerOverlayLogic.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.settingList = m.top.findNode("settingList")
    m.settingList.ObserveField("itemSelected", FuncName(OnSettingSelected))

    m.closeButton = m.top.findNode("closeButton")
    m.closeButton.translation = [720 / 2 - m.closeButton.width / 2, m.closeButton.translation[1]]
    m.closeButton.observeField("buttonSelected", FuncName(Close))

    m.settingOptions = {}
    m.settingOptions["playback.subtitle_text_color"] = ColorOptions()
    m.settingOptions["playback.subtitle_background_color"] = ColorOptions()
    m.settingOptions["playback.subtitle_background_opacity"] = OpacityOptions()

    SetNavigation(m.settingList, RemoteKeys.Down, m.closeButton)
    SetNavigation(m.closeButton, RemoteKeys.Up, m.settingList)
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if

    NodeSetFocus(m.settingList, true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if NavigationKeyHandler(key, press).handled
        return true
    end if

    if key = RemoteKeys.Options or key = RemoteKeys.Play or key = RemoteKeys.Pause or key = RemoteKeys.PlayOnly
        ' A pass-through to the app controller, so it can toggle picture-in-picture and pause/play
        return false
    end if

    if key = RemoteKeys.Back and press
        Close()
        return true
    end if

    return true
end function

function OnPreferencesSet() as void
    preferences = m.top.preferences
    if preferences = invalid
        return
    end if

    content = CreateObject("roSGNode", "ContentNode")
    for each setting in SettingsList()
        node = CreateObject("roSGNode", "SubtitleSettingContent")
        node.settingKey = setting.key
        node.settingTitle = Tr(setting.title)
        node.currentValue = CurrentValueText(preferences, setting.key)
        content.appendChild(node)
    end for
    m.settingList.content = content
end function

function SettingsList() as object
    return [
        { key: "playback.subtitle_text_color", title: Locale.Settings.SubtitleTextColor }
        { key: "playback.subtitle_background_color", title: Locale.Settings.SubtitleBackgroundColor }
        { key: "playback.subtitle_background_opacity", title: Locale.Settings.SubtitleBackgroundOpacity }
    ]
end function

function ColorOptions() as object
    options = []
    for each color in PlayerOverlayLogic.CaptionColors()
        options.Push({ value: color, title: PlayerOverlayLogic.CaptionColorText(color) })
    end for
    return options
end function

function OpacityOptions() as object
    options = []
    for each opacity in PlayerOverlayLogic.CaptionOpacities()
        options.Push({ value: opacity, title: PlayerOverlayLogic.CaptionOpacityText(opacity) })
    end for
    return options
end function

function CurrentValueText(preferences as object, key as string) as string
    value = ValidString(preferences[key])
    if value = ""
        value = "Default"
    end if
    return OptionText(key, value)
end function

function OptionText(key as string, value as string) as string
    if key = "playback.subtitle_background_opacity"
        return PlayerOverlayLogic.CaptionOpacityText(value)
    end if
    return PlayerOverlayLogic.CaptionColorText(value)
end function

function OnSettingSelected(event as object) as void
    itemSelected = event.GetData()
    itemNode = m.settingList.content.GetChild(itemSelected)
    if itemNode = invalid
        return
    end if

    options = m.settingOptions[itemNode.settingKey]
    buttonTitles = []
    for each option in options
        buttonTitles.Push(option.title)
    end for

    dialog = DialogUtils.ShowDialogEx({
        title: itemNode.settingTitle
        message: Tr(Locale.Settings.SelectOptionFor).Replace("%1", itemNode.settingTitle)
        buttons: buttonTitles
    })
    if dialog = invalid
        return
    end if
    dialog.addFields({
        "settingKey": itemNode.settingKey
        "options": options
    })
    dialog.observeField("buttonSelected", FuncName(OnSettingDialogResult), ["buttonSelected"])
end function

function OnSettingDialogResult(event as object) as void
    dialog = event.getRoSGNode()
    options = dialog.options
    buttonIndex = event.GetData()

    if not IsInt(buttonIndex) or buttonIndex < 0 or buttonIndex >= options.Count()
        return
    end if

    key = dialog.settingKey
    value = options[buttonIndex].value
    if m.top.preferences <> invalid and m.top.preferences.hasField(key)
        m.top.preferences[key] = value
    end if

    content = m.settingList.content
    if content = invalid
        return
    end if
    for each child in content.getChildren(-1, 0)
        if child.settingKey = key
            child.currentValue = OptionText(key, value)
        end if
    end for
end function

function Close()
    m.appController@.PopScreen()
end function
