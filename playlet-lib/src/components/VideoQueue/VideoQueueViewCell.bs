import "pkg:/components/Services/DeArrow/DeArrowCell.bs"
import "pkg:/components/Services/DeArrow/DeArrowService.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.thumbnailPoster = m.top.FindNode("thumbnailPoster")
    m.titleLabel = m.top.FindNode("titleLabel")
    m.durationRect = m.top.FindNode("durationRect")
    m.durationLabel = m.top.FindNode("durationLabel")
    m.dearrowIcon = m.top.FindNode("dearrowIcon")
end function

function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    m.top.title = content.title
    m.titleLabel.rawText = ValidString(content.title)
    m.top.thumbnailUri = content.thumbnail

    SetDurationText(content.lengthText)
    SetHighlight()

    DeArrowCell.HandleContentSet(m, content, FuncName(OnDeArrowChanged), FuncName(OnDeArrowJobDone))
    ApplyDeArrow()
end function

function OnDeArrowChanged(event as object) as void
    content = event.getRoSGNode()
    if m.top.itemContent = invalid or not m.top.itemContent.isSameNode(content)
        return
    end if
    ApplyDeArrow()
end function

function OnDeArrowJobDone(event as object) as void
    DeArrowCell.OnJobDone(m, event)
end function

' Re-projects the DeArrow fields the content node carries; runs both when the content is first set
' (possibly already resolved) and when a job answer lands.
function ApplyDeArrow() as void
    content = m.top.itemContent
    iconUri = DeArrowCell.IconUri(content, m.global)
    if m.dearrowIcon <> invalid
        m.dearrowIcon.visible = iconUri <> ""
        m.dearrowIcon.uri = iconUri
    end if
    if content = invalid or not content.hasField("dearrowState")
        return
    end if
    state = ValidString(content.dearrowState)
    if DeArrowCell.HasTitle(state)
        m.top.title = content.title
        m.titleLabel.rawText = ValidString(content.title)
    end if
    if DeArrowCell.HasThumbnail(state)
        ' the community thumbnail goes in directly, the original stays as the poster's load fallback
        m.thumbnailPoster.fallbackUri = ValidString(content.thumbnail)
        m.thumbnailPoster.uri = ValidString(content.dearrowThumbnail)
    end if
end function

function OnIndexSet() as void
    SetHighlight()
end function

function SetDurationText(text as string) as void
    hasText = text <> ""
    m.top.durationRectVisible = hasText
    if not hasText
        return
    end if

    m.top.duration = text

    label = m.durationLabel
    rect = m.durationRect

    if label = invalid or rect = invalid
        return
    end if

    rectParent = rect.getParent()
    size = label.localBoundingRect()

    rect.width = size.width + 16
    rect.translation = [rectParent.width - rect.width, rect.translation[1]]
end function

function SetHighlight() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    contentIndex = content.queueIndex
    index = m.top.index

    highlighted = contentIndex = index

    if highlighted
        ' bs:disable-next-line LINT3023
        m.top.thumbnailBlendColor = "#FFFFFFFF"
    else
        m.top.thumbnailBlendColor = "#606060FF"
    end if

    m.top.highlightVisible = highlighted
end function
