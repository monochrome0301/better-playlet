import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/Types.bs"

namespace PlaylistEdit

    ' Returns { ok: true, auth } when the profile can edit playlists, else { error } with one of:
    ' "notLoggedIn", "needsReauth", or the token-refresh failure state.
    function EnsureEditablePlaylists(profile as object) as object
        if profile = invalid
            return {
                error: "notLoggedIn"
            }
        end if
        if profile.authState = ProfileContentAuthTokenUtils.ProfileAuthState.NeedsReauth
            return {
                error: "needsReauth"
            }
        end if

        auth = ProfileContentAuthTokenUtils.EnsureFreshAccessToken(profile)
        if auth.state <> ProfileContentAuthTokenUtils.AccessTokenState.Ok
            return {
                error: auth.state
            }
        end if

        return {
            ok: true
            auth: auth
        }
    end function

    ' Flattens the FEplaylist_aggregation feeds into [{ playlistId, title }].
    ' Mixes (RD...) are generated by YouTube and cannot be edited, so they are dropped.
    function PlaylistsFromFeeds(feeds as object) as object
        playlists = []
        if not IsArray(feeds)
            return playlists
        end if

        for each feed in feeds
            if not IsAssociativeArray(feed)
                continue for
            end if
            items = feed.items
            if not IsArray(items)
                continue for
            end if
            for each item in items
                if not IsAssociativeArray(item) or item.type <> "playlist"
                    continue for
                end if
                playlistId = ValidString(item.playlistId)
                if playlistId = "" or playlistId.StartsWith("RD")
                    continue for
                end if
                playlists.Push({
                    playlistId: playlistId
                    title: ValidString(item.title)
                })
            end for
        end for

        return playlists
    end function

end namespace
