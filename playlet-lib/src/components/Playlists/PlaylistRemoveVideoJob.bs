import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.bs"
import "pkg:/components/Services/Innertube/InnertubeService.bs"

' removedVideoId: the entry's setVideoId when known, otherwise the plain videoId (see EditPlaylistEndpoint).
@job("PlaylistRemoveVideoJob")
function ExecuteJob() as void
    input = JobGetInput()
    profile = input.profile
    playlistId = input.playlistId
    removedVideoId = input.removedVideoId

    if JobIsCancelled()
        JobCancel()
        return
    end if

    cancellation = JobGetCancellation()

    auth = ProfileContentAuthTokenUtils.EnsureFreshAccessToken(profile)
    if auth.state <> ProfileContentAuthTokenUtils.AccessTokenState.Ok
        JobError("No usable access token to edit playlists: " + auth.state)
        return
    end if

    result = InnertubeService.RemoveVideoFromPlaylist(playlistId, removedVideoId, {
        accessToken: auth.token
        onBehalfOfUser: auth.activeIdentifyToken
        cancellation: cancellation
    })
    if result.error <> invalid
        JobError("Failed to remove video from playlist: " + ToString(result.error))
        return
    end if

    JobSuccess()
end function
