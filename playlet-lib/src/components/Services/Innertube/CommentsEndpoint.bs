import "pkg:/components/Services/Innertube/NextEndpoint.bs"
import "pkg:/components/Services/Innertube/Parser.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/ObjectUtils.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

namespace Innertube

    ' engagementToolbarStateEntityPayload.heartState seen when the video's creator hearted a comment.
    const HEARTED_TOOLBAR_STATE = "TOOLBAR_HEART_STATE_HEARTED"

    ' One page of comments: the video's top-level comments (empty continuation resolves the token from the watch
    ' page first) or one comment's replies (the token straight from that comment's thread).
    function GetCommentsPage(videoId as string, continuation as string, cancellation as object) as object
        if StringUtils.IsNullOrEmpty(continuation)
            nextRequest = CreateNextRequest({ "videoId": videoId })
            nextRequest.Cancellation(cancellation)
            nextResponse = nextRequest.Await()
            if not nextResponse.IsSuccess()
                return { error: nextResponse.ErrorMessage() }
            end if

            continuation = FindCommentsContinuation(nextResponse.Json())
            if StringUtils.IsNullOrEmpty(continuation)
                return { comments: [], continuation: "", count: "", disabled: true }
            end if
        end if

        request = CreateNextRequest({ "continuation": continuation })
        request.Cancellation(cancellation)
        response = request.Await()
        if not response.IsSuccess()
            return { error: response.ErrorMessage() }
        end if

        payload = response.Json()
        if not IsAssociativeArray(payload)
            return { error: "Invalid comments response" }
        end if

        return ParseCommentsResponse(payload)
    end function

    ' The comments section continuation token from the watch page, or "" when the video has no comments section.
    function FindCommentsContinuation(payload as object) as string
        sections = ObjectUtils.Dig(payload, ["contents", "twoColumnWatchNextResults", "results", "results", "contents"])
        if not IsArray(sections)
            return ""
        end if

        for each section in sections
            renderer = ObjectUtils.Dig(section, ["itemSectionRenderer"])
            if ValidString(ObjectUtils.Dig(renderer, ["sectionIdentifier"])) <> "comment-item-section"
                continue for
            end if
            token = FindContinuationToken(renderer.contents)
            if token <> ""
                return token
            end if
        end for

        return ""
    end function

    function FindContinuationToken(items as dynamic) as string
        if not IsArray(items)
            return ""
        end if
        for each item in items
            token = ObjectUtils.Dig(item, ["continuationItemRenderer", "continuationEndpoint", "continuationCommand", "token"])
            if not IsString(token)
                ' "View replies" / "Load more" render the same continuation command as a button.
                token = ObjectUtils.Dig(item, ["continuationItemRenderer", "button", "buttonRenderer", "command", "continuationCommand", "token"])
            end if
            if IsString(token) and token <> ""
                return token
            end if
        end for
        return ""
    end function

    ' The replies continuation token of one comment thread, or "" when the comment has no replies. The first
    ' replies page carries the button to load the rest, so only the token is needed here.
    function FindRepliesContinuation(thread as object) as string
        replies = ObjectUtils.Dig(thread, ["replies"])
        if IsAssociativeArray(replies)
            ' The reply container sits on `replies` itself or under commentRepliesRenderer, depending on the client.
            for each container in [replies, ObjectUtils.Dig(replies, ["commentRepliesRenderer"])]
                if not IsAssociativeArray(container)
                    continue for
                end if
                for each key in ["contents", "subThreads", "moreReplies"]
                    token = FindContinuationToken(container[key])
                    if token <> ""
                        return token
                    end if
                end for
                ' "View replies" carries its own button.
                token = ValidString(ObjectUtils.Dig(container, ["viewReplies", "buttonRenderer", "command", "continuationCommand", "token"]))
                if token <> ""
                    return token
                end if
            end for
        end if
        ' classic renderer: commentRenderer.moreReplies holds the same continuation item shape.
        return FindContinuationToken(ObjectUtils.Dig(thread, ["comment", "commentRenderer", "moreReplies"]))
    end function

    function ParseCommentsResponse(payload as object) as object
        result = {
            comments: []
            continuation: ""
            count: ""
            disabled: false
        }

        ' Comment bodies live in frameworkUpdates entities, keyed by the commentViewModel on each thread; the
        ' creator-heart state rides the same batch in a separate toolbar-state entity.
        entities = ParseCommentEntities(payload)
        toolbarStates = ParseToolbarStates(payload)

        items = []
        commands = payload.onResponseReceivedEndpoints
        if IsArray(commands)
            for each command in commands
                ' replies pages arrive as appendContinuationItemsAction, not ...Command.
                for each key in ["reloadContinuationItemsCommand", "appendContinuationItemsCommand", "appendContinuationItemsAction"]
                    continuationItems = ObjectUtils.Dig(command, [key, "continuationItems"])
                    if IsArray(continuationItems)
                        items.Append(continuationItems)
                    end if
                end for
            end for
        end if

        ' Older responses deliver the page under continuationContents instead.
        if items.Count() = 0
            legacyItems = ObjectUtils.Dig(payload, ["continuationContents", "commentSectionContinuation", "contents"])
            if IsArray(legacyItems)
                items.Append(legacyItems)
            end if
        end if

        for each item in items
            header = ObjectUtils.Dig(item, ["commentsHeaderRenderer"])
            if IsAssociativeArray(header)
                result.count = ParseCommentCount(ObjectUtils.Dig(header, ["countText"]))
                continue for
            end if

            thread = ObjectUtils.Dig(item, ["commentThreadRenderer"])
            if not IsAssociativeArray(thread) and IsAssociativeArray(ObjectUtils.Dig(item, ["commentViewModel"]))
                ' A reply page may deliver the reply as the bare view model, with no thread wrapper.
                thread = item
            end if
            if IsAssociativeArray(thread)
                comment = ParseCommentThread(thread, entities, toolbarStates)
                if comment <> invalid
                    result.comments.Push(comment)
                end if
                continue for
            end if

            token = ObjectUtils.Dig(item, ["continuationItemRenderer", "continuationEndpoint", "continuationCommand", "token"])
            if IsString(token) and token <> ""
                result.continuation = token
            end if
        end for

        if result.continuation = ""
            result.continuation = ValidString(ObjectUtils.Dig(payload, ["continuationContents", "commentSectionContinuation", "continuations", 0, "nextContinuationData", "continuation"]))
        end if

        return result
    end function

    function ParseCommentEntities(payload as object) as object
        return ParseEntities(payload, "commentEntityPayload")
    end function

    ' The toolbar-state entities (heartState / likeState), keyed by the thread's toolbarStateKey.
    function ParseToolbarStates(payload as object) as object
        return ParseEntities(payload, "engagementToolbarStateEntityPayload")
    end function

    function ParseEntities(payload as object, payloadKey as string) as object
        entities = {}
        mutations = ObjectUtils.Dig(payload, ["frameworkUpdates", "entityBatchUpdate", "mutations"])
        if not IsArray(mutations)
            return entities
        end if
        for each mutation in mutations
            entity = ObjectUtils.Dig(mutation, ["payload", payloadKey])
            if IsAssociativeArray(entity)
                key = ValidString(entity.key)
                if key <> ""
                    entities[key] = entity
                end if
            end if
        end for
        return entities
    end function

    function ParseCommentThread(thread as object, entities as object, toolbarStates as object) as dynamic
        viewModel = ObjectUtils.Dig(thread, ["commentViewModel", "commentViewModel"])
        if not IsAssociativeArray(viewModel)
            viewModel = ObjectUtils.Dig(thread, ["commentViewModel"])
        end if
        if IsAssociativeArray(viewModel)
            entity = entities[ValidString(viewModel.commentKey)]
            if IsAssociativeArray(entity)
                properties = ValidAssociativeArray(entity.properties)
                author = ValidAssociativeArray(entity.author)
                toolbar = ValidAssociativeArray(entity.toolbar)
                return {
                    author: ValidString(author.displayName)
                    text: ValidString(ObjectUtils.Dig(properties, ["content", "content"]))
                    publishedTime: ValidString(properties.publishedTime)
                    likes: ValidString(toolbar.likeCountNotliked)
                    replies: ValidString(toolbar.replyCount)
                    hearted: ToolbarHearted(toolbar, toolbarStates[ValidString(viewModel.toolbarStateKey)])
                    replyContinuation: FindRepliesContinuation(thread)
                }
            end if
        end if

        ' Classic renderer, still returned by some clients.
        renderer = ObjectUtils.Dig(thread, ["comment", "commentRenderer"])
        if not IsAssociativeArray(renderer)
            return invalid
        end if

        return {
            author: ParseText(ObjectUtils.Dig(renderer, ["authorText"]))
            text: ParseText(ObjectUtils.Dig(renderer, ["contentText"]))
            publishedTime: ParseText(ObjectUtils.Dig(renderer, ["publishedTimeText"]))
            likes: ParseText(ObjectUtils.Dig(renderer, ["voteCount"]))
            replies: ValidString(renderer.replyCount)
            hearted: ClassicHearted(renderer)
            replyContinuation: FindRepliesContinuation(thread)
        }
    end function

    ' The modern heart state: the toolbarStateKey's entity, or the inline toolbar state when the response
    ' carries it there instead.
    function ToolbarHearted(toolbar as object, toolbarState as object) as boolean
        if IsAssociativeArray(toolbarState)
            return ValidString(toolbarState.heartState) = HEARTED_TOOLBAR_STATE
        end if
        return ValidString(toolbar.heartState) = HEARTED_TOOLBAR_STATE
    end function

    ' The classic renderer's creatorHeart node, which only appears (isHearted=true) on a hearted comment.
    function ClassicHearted(renderer as object) as boolean
        for each path in [["creatorHeart"], ["actionButtons", "commentActionButtonsRenderer", "creatorHeart"]]
            heart = ObjectUtils.Dig(renderer, path)
            if IsAssociativeArray(heart)
                return ValidBool(heart.isHearted)
            end if
        end for
        return false
    end function

    function ParseCommentCount(countText as object) as string
        text = ParseText(countText)
        ' e.g. "2,460,368 Comments" -> "2,460,368"
        if text.InStr(" Comments") <> -1
            return text.Left(text.InStr(" Comments"))
        end if
        return ""
    end function

end namespace
