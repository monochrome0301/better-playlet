import "pkg:/components/Services/DeArrow/DeArrowCell.bs"
import "pkg:/components/Services/DeArrow/DeArrowService.bs"
import "pkg:/source/utils/EmojiText.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    FindNodes()
end function

' Grid cells can have their content set before Init runs (the same race RowCell works around with
' aliases): resolve the nodes again whenever a reference is missing.
function FindNodes() as void
    m.thumbnail = m.top.findNode("thumbnail")
    m.titleLabel = m.top.findNode("titleLabel")
    m.metaLabel = m.top.findNode("metaLabel")
    m.durationRect = m.top.findNode("durationRect")
    m.durationLabel = m.top.findNode("durationLabel")
    m.loadMoreRect = m.top.findNode("loadMoreRect")
    m.loadMoreLabel = m.top.findNode("loadMoreLabel")
    m.dearrowIcon = m.top.findNode("dearrowIcon")
end function

function OnContentSet() as void
    if m.thumbnail = invalid or m.titleLabel = invalid or m.metaLabel = invalid
        FindNodes()
    end if
    content = m.top.itemContent
    if content = invalid or m.titleLabel = invalid or m.metaLabel = invalid or m.thumbnail = invalid
        return
    end if

    ' The last tile is not a video: it asks the feed for the next page.
    loadMore = content.hasField("loadMore") and content.loadMore = true
    m.loadMoreRect.visible = loadMore
    m.loadMoreLabel.text = ""
    if loadMore
        m.loadMoreLabel.text = ValidString(content.title)
    end if
    m.thumbnail.visible = not loadMore
    m.titleLabel.visible = not loadMore
    m.metaLabel.visible = not loadMore
    if loadMore
        return
    end if

    title = ValidString(content.title)
    m.titleLabel.rawText = title
    ' The EmojiLabel derives its markup text from rawText in its own observer, which can race the cell
    ' being recycled on a fast grid; setting the identical markup here makes the title show regardless
    ' of which callback lands first.
    m.titleLabel.text = EmojiText.Markup(title)
    m.thumbnail.uri = ValidString(content.thumbnail)
    ' The meta line sits right below however many lines the title took, with no extra gap.
    titleHeight = m.titleLabel.localBoundingRect().height
    m.metaLabel.translation = [0, 204 + titleHeight + 2]
    m.metaLabel.text = MetaText(content)
    duration = ValidString(content.lengthText)
    m.durationRect.visible = duration <> ""
    m.durationLabel.text = duration

    DeArrowCell.HandleContentSet(m, content, FuncName(OnDeArrowChanged), FuncName(OnDeArrowJobDone))
    ApplyDeArrow()
end function

function OnDeArrowChanged(event as object) as void
    if m.titleLabel = invalid or m.dearrowIcon = invalid
        FindNodes()
    end if
    content = event.getRoSGNode()
    if m.top.itemContent = invalid or not m.top.itemContent.isSameNode(content)
        return
    end if
    ApplyDeArrow()
end function

function OnDeArrowJobDone(event as object) as void
    DeArrowCell.OnJobDone(m, event)
end function

' Re-projects the DeArrow fields the content node carries; runs both when the content is first set
' (possibly already resolved) and when a job answer lands.
function ApplyDeArrow() as void
    content = m.top.itemContent
    iconUri = DeArrowCell.IconUri(content, m.global)
    if m.dearrowIcon <> invalid
        m.dearrowIcon.visible = iconUri <> ""
        m.dearrowIcon.uri = iconUri
    end if
    if content = invalid or not content.hasField("dearrowState")
        return
    end if
    state = ValidString(content.dearrowState)
    if not DeArrowCell.HasTitle(state)
        return
    end if
    title = ValidString(content.title)
    m.titleLabel.rawText = title
    m.titleLabel.text = EmojiText.Markup(title)
    ' the meta line follows the title's height, which a replaced title can change
    titleHeight = m.titleLabel.localBoundingRect().height
    m.metaLabel.translation = [0, 204 + titleHeight + 2]
    if DeArrowCell.HasThumbnail(state)
        m.thumbnail.fallbackUri = ValidString(content.thumbnail)
        m.thumbnail.uri = ValidString(content.dearrowThumbnail)
    end if
end function

' The one-line meta under the title, as far as the recommendation carries each part. Lockup recommendations
' carry both the author and the "views · age" line only in `lines`; compact ones carry the named fields.
function MetaText(content as object) as string
    parts = []
    author = ValidString(content._author)
    lines = content.lines
    if IsArray(lines) and lines.Count() > 0
        if author = ""
            author = ValidString(lines[0])
        end if
    end if
    if author <> ""
        parts.Push(author)
    end if

    viewCount = ValidString(content.viewCountText)
    if viewCount <> ""
        parts.Push(viewCount)
    end if
    published = ValidString(content.publishedText)
    if published <> ""
        parts.Push(published)
    end if
    if viewCount = "" and published = "" and IsArray(lines) and lines.Count() > 1
        details = ValidString(lines[1])
        if details <> ""
            parts.Push(details)
        end if
    end if
    return parts.Join(" · ")
end function
