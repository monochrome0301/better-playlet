import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.top.focusable = true
    m.grid = m.top.findNode("grid")
    m.statusLabel = m.top.findNode("statusLabel")
    m.grid.observeField("itemSelected", FuncName(OnItemSelected))
    m.grid.observeField("upAtTop", FuncName(OnUpAtTop))
    OnStatusSet()
end function

' The grid owns navigation and selection; the overlay only reports the pick, the load-more tile, and Back.
function OnItemSelected(event as object) as void
    index = event.getData()
    item = invalid
    if m.grid.content <> invalid
        item = m.grid.content.getChild(index)
    end if
    if item <> invalid and item.hasField("loadMore") and item.loadMore
        m.top.loadMore = true
        return
    end if
    m.top.selected = { index: index }
end function

' Up on the feed's first row leaves the feed.
function OnUpAtTop() as void
    m.top.closed = true
end function

function OnFocusIndexSet() as void
    if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.jumpToItem = m.top.focusIndex
    end if
end function

function OnStatusSet() as void
    status = m.top.status
    m.statusLabel.text = status
    m.statusLabel.visible = status <> ""
end function

function OnFocusChange() as void
    NodeSetFocus(m.grid, m.top.focus)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Back
        m.top.closed = true
        return true
    end if
    return false
end function
