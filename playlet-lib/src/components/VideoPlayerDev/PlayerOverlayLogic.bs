import "pkg:/source/utils/CodecCapabilities.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/LocaleUtils.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/Types.bs"

' Pure menu data for the player's settings overlay: what each level lists and which row is selected.
' The coordinator owns the nodes and the key routing; these are plain functions of the loaded content.
namespace PlayerOverlayLogic

    enum Level
        None = ""
        Main = "main"
        Quality = "quality"
        Subtitles = "subtitles"
        SubtitleTextColor = "subtitleTextColor"
        SubtitleBackgroundColor = "subtitleBackgroundColor"
        SubtitleBackgroundOpacity = "subtitleBackgroundOpacity"
        Audio = "audio"
        Speed = "speed"
        Channel = "channel"
    end enum

    ' [x] marks the active option; fixed width so the labels line up in a LabelList.
    function Option(title as string, value as string, selected as boolean) as object
        if selected
            return { title: "[x] " + title, value: value }
        end if
        return { title: "[  ] " + title, value: value }
    end function

    ' Auto, then every distinct height in the video's adaptive formats, sharpest first.
    ' Empty when the metadata offers no distinct height (the row is then hidden).
    function BuildQualityOptions(metadata as object, selectedQuality as string) as object
        heights = {}
        formats = invalid
        if IsAssociativeArray(metadata)
            formats = metadata.adaptiveFormats
        end if
        if IsArray(formats)
            ' 1440p/2160p exist on YouTube only as AV1/VP9 and the DASH player plays fragmented MP4, so the
            ' options stop at 1080p on devices without an AV1 decoder (same rule as the settings screen).
            allowHighQuality = CodecCapabilities.CanDecodeAv1()
            for each format in formats
                if not IsAssociativeArray(format)
                    continue for
                end if
                height = FormatHeight(format)
                if height > 0 and (height <= 1080 or allowHighQuality)
                    heights[height.ToStr()] = true
                end if
            end for
        end if

        sorted = []
        for each key in heights
            sorted.Push(key.ToInt())
        end for
        for i = 0 to sorted.Count() - 2
            for j = i + 1 to sorted.Count() - 1
                if sorted[j] > sorted[i]
                    swap = sorted[i]
                    sorted[i] = sorted[j]
                    sorted[j] = swap
                end if
            end for
        end for

        if sorted.Count() = 0
            return []
        end if

        options = [Option(Tr(Locale.Settings.AutoQuality), "auto", IsAutoQuality(selectedQuality))]
        for each height in sorted
            value = height.ToStr() + "p"
            options.Push(Option(value, value, HasQuality(selectedQuality, value)))
        end for
        return options
    end function

    ' Innertube formats carry height; Invidious sometimes only has "resolution" ("1080p60") or "size"
    ' ("1920x1080"). Either way, the quality list needs the vertical resolution.
    function FormatHeight(format as object) as integer
        height = ValidInt(format.height)
        if height > 0
            return height
        end if

        resolution = ValidString(format.resolution)
        pIndex = resolution.InStr("p")
        if pIndex > 0
            return ValidInt(resolution.Left(pIndex))
        end if

        size = ValidString(format.size)
        if size.InStr("x") > 0
            return ValidInt(size.Split("x")[1])
        end if

        return 0
    end function

    function IsAutoQuality(quality as string) as boolean
        return quality = "" or quality = "auto"
    end function

    function HasQuality(quality as string, value as string) as boolean
        if IsAutoQuality(quality)
            return false
        end if
        for each entry in quality.Split(",")
            if entry.Trim() = value
                return true
            end if
        end for
        return false
    end function

    ' Off + the video's side-loaded caption tracks.
    function BuildSubtitleOptions(tracks as object, selectedTrack as object) as object
        options = [Option(Tr(Locale.PlaybackMenu.Off), "off", selectedTrack = invalid)]
        if not IsArray(tracks)
            return options
        end if
        for i = 0 to tracks.Count() - 1
            track = tracks[i]
            if not IsAssociativeArray(track)
                continue for
            end if
            options.Push(Option(TrackLabel(track), i.ToStr(), SameTrack(track, selectedTrack)))
        end for
        return options
    end function

    ' The Roku caption renderer's color values (same list as the OS captions settings).
    function CaptionColors() as object
        return ["Default", "White", "Black", "Red", "Green", "Blue", "Yellow", "Magenta", "Cyan"]
    end function

    function CaptionColorText(value as string) as string
        return Tr(value)
    end function

    function BuildCaptionColorOptions(selectedColor as string) as object
        options = []
        for each color in CaptionColors()
            options.Push(Option(CaptionColorText(color), color, color = selectedColor))
        end for
        return options
    end function

    ' Roku's background opacity values, including Off (no background) and Default (the OS setting).
    function CaptionOpacities() as object
        return ["Default", "Off", "25%", "50%", "75%", "100%"]
    end function

    function CaptionOpacityText(value as string) as string
        if value = "Off"
            return Tr(Locale.PlaybackMenu.Off)
        end if
        return Tr(value)
    end function

    function BuildCaptionOpacityOptions(selectedOpacity as string) as object
        options = []
        for each opacity in CaptionOpacities()
            options.Push(Option(CaptionOpacityText(opacity), opacity, opacity = selectedOpacity))
        end for
        return options
    end function

    ' The appearance rows appended to the subtitle level. Each opens its own choice list.
    function SubtitleStyleRows(textColor as string, backgroundColor as string, backgroundOpacity as string) as object
        return [
            { title: Tr(Locale.PlaybackMenu.TextColor) + ": " + CaptionColorText(textColor), value: Level.SubtitleTextColor }
            { title: Tr(Locale.PlaybackMenu.BackgroundColor) + ": " + CaptionColorText(backgroundColor), value: Level.SubtitleBackgroundColor }
            { title: Tr(Locale.PlaybackMenu.BackgroundOpacity) + ": " + CaptionOpacityText(backgroundOpacity), value: Level.SubtitleBackgroundOpacity }
        ]
    end function

    ' The DASH manifest's audio tracks (languages / auto-dubbed variants).
    function BuildAudioOptions(tracks as object, selectedTrack as object) as object
        options = []
        if not IsArray(tracks)
            return options
        end if
        for i = 0 to tracks.Count() - 1
            track = tracks[i]
            if not IsAssociativeArray(track)
                continue for
            end if
            options.Push(Option(TrackLabel(track), i.ToStr(), SameTrack(track, selectedTrack)))
        end for
        return options
    end function

    function TrackLabel(track as object) as string
        label = ValidString(track.Description)
        if label = ""
            label = ValidString(track.Language)
        end if
        if label = ""
            label = ValidString(track.TrackName)
        end if
        return label
    end function

    function SameTrack(track as object, selectedTrack as object) as boolean
        if not IsAssociativeArray(selectedTrack)
            return false
        end if
        trackName = ValidString(track.TrackName)
        if trackName <> ""
            return trackName = ValidString(selectedTrack.TrackName)
        end if
        return ValidString(track.Language) = ValidString(selectedTrack.Language)
    end function

    ' YouTube's playback speeds, in menu order. The string is the value a row carries (parsed back to the float).
    function SpeedChoices() as object
        return ["0.25", "0.5", "0.75", "1", "1.25", "1.5", "1.75", "2"]
    end function

    ' One speed as YouTube labels it: "Normal" for 1x, otherwise "<n>x".
    function SpeedText(value as string) as string
        if value = "1"
            return Tr(Locale.PlaybackMenu.NormalSpeed)
        end if
        return value + "x"
    end function

    ' A live speed as the main row shows it: the menu label when it is one of YouTube's, else the raw number.
    function SpeedTextFor(speed as float) as string
        for each value in SpeedChoices()
            if Abs(value.ToFloat() - speed) < 0.001
                return SpeedText(value)
            end if
        end for
        return speed.ToStr() + "x"
    end function

    function BuildSpeedOptions(speed as float) as object
        options = []
        for each value in SpeedChoices()
            options.Push(Option(SpeedText(value), value, Abs(value.ToFloat() - speed) < 0.001))
        end for
        return options
    end function

    ' NOTE: the quality flag is NOT named hasQuality: case-insensitively that collides with the HasQuality function
    ' above, and the compiler then mangles the reference to the function instead of the parameter (if <function>
    ' throws at runtime, killing BuildMainMenuRows and silently keeping the menu closed).
    function MainRows(qualityLabel as string, showQuality as boolean, subtitleLabel as string, hasSubtitles as boolean, audioLabel as string, hasAudio as boolean, speedLabel as string) as object
        rows = []
        if showQuality
            rows.Push({ title: Tr(Locale.PlaybackMenu.Quality) + ": " + qualityLabel, value: Level.Quality })
        end if
        if hasSubtitles
            rows.Push({ title: Tr(Locale.PlaybackMenu.Subtitles) + ": " + subtitleLabel, value: Level.Subtitles })
        end if
        if hasAudio
            rows.Push({ title: Tr(Locale.PlaybackMenu.Audio) + ": " + audioLabel, value: Level.Audio })
        end if
        if speedLabel <> ""
            rows.Push({ title: Tr(Locale.PlaybackMenu.Speed) + ": " + speedLabel, value: Level.Speed })
        end if
        rows.Push({ title: Tr(Locale.PlaybackMenu.VideoDescription), value: "details" })
        rows.Push({ title: Tr(Locale.PlaybackMenu.Comments), value: "comments" })
        return rows
    end function

    ' --- Video details overlay ---

    ' Author · views · likes, as far as the backend provided them (YouTube hides likes on some videos),
    ' plus Return YouTube Dislike's estimate when it arrived.
    function DetailsStats(metadata as object, votes = invalid as dynamic) as string
        parts = []
        if not IsAssociativeArray(metadata)
            return ""
        end if

        author = ValidString(metadata.author)
        if author <> ""
            parts.Push(author)
        end if

        viewCount = ValidInt(metadata.viewCount)
        if viewCount > 0
            parts.Push(LocaleUtils.GetFormattedPluralString(viewCount, Locale.RowCell.ZeroViews, Locale.RowCell.OneView, Locale.RowCell.NViews))
        end if

        ' YouTube's watch page gives a compact, already-formatted like count ("1.2K"); Invidious gives the number.
        likeCountText = ValidString(metadata.likeCountText)
        likeCount = ValidInt(metadata.likeCount)
        if likeCountText <> ""
            parts.Push(Tr(Locale.PlaybackMenu.Likes) + ": " + likeCountText)
        else if likeCount > 0
            parts.Push(LocaleUtils.GetFormattedPluralString(likeCount, Locale.RowCell.ZeroLikes, Locale.RowCell.OneLike, Locale.RowCell.NLikes))
        end if

        if IsAssociativeArray(votes)
            parts.Push(LocaleUtils.GetFormattedPluralString(ValidInt(votes.dislikes), Locale.RowCell.ZeroDislikes, Locale.RowCell.OneDislike, Locale.RowCell.NDislikes))
            rating = ValidFloat(votes.rating)
            if rating > 0
                parts.Push(Tr(Locale.PlaybackMenu.VideoRating) + ": " + MathUtils.FormatFloat(rating).ToStr() + "/5")
            end if
        end if

        return parts.Join(" · ")
    end function

    ' RYD asks for clear attribution where its estimates are shown.
    function DetailsAttribution(votes as object) as string
        if not IsAssociativeArray(votes)
            return ""
        end if
        return Tr(Locale.PlaybackMenu.DislikesBy)
    end function

    function DetailsDescription(metadata as object) as string
        if not IsAssociativeArray(metadata)
            return Tr(Locale.PlaybackMenu.NoDescription)
        end if
        description = ValidString(metadata.description).Trim()
        if description = ""
            return Tr(Locale.PlaybackMenu.NoDescription)
        end if
        return description
    end function

    ' The game the video is about, when YouTube's structured description has one.
    function DetailsGame(metadata as object) as object
        game = ValidAssociativeArray(metadata).game
        if not IsAssociativeArray(game)
            return invalid
        end if
        title = ValidString(game.title)
        if title = ""
            return invalid
        end if
        return {
            title: title
            year: ValidString(game.year)
            image: ValidString(game.image)
        }
    end function

    ' The description's selectable links as the details overlay shows them: the raw label (used as the title of a
    ' video opened from a link) plus the type-prefixed row text.
    function DescriptionLinkRows(metadata as object) as object
        rows = []
        links = ValidArray(ValidAssociativeArray(metadata).descriptionLinks)
        for each link in links
            if not IsAssociativeArray(link)
                continue for
            end if
            kind = ValidString(link.kind)
            id = ValidString(link.id)
            if id = ""
                continue for
            end if
            label = ValidString(link.label).Trim()
            if label = ""
                label = id
            end if
            if kind = "channel"
                text = Tr(Locale.SearchFilters.Channel) + ": " + label
            else
                text = Tr(Locale.SearchFilters.Video) + ": " + label
            end if
            rows.Push({ kind: kind, id: id, label: label, text: text })
        end for
        return rows
    end function

    ' --- Channel button (bottom-left of the player) ---

    ' The channel the logo button opens. The played queue item carries authorId when the metadata does not.
    function ChannelId(metadata as object, content as object) as string
        id = ValidString(ValidAssociativeArray(metadata).authorId)
        if id = "" and content <> invalid and content.hasField("authorId")
            id = ValidString(content.authorId)
        end if
        return id
    end function

    ' The channel's avatar: Innertube's owner renderer, Invidious's author thumbnails, or the generic user icon.
    function ChannelAvatarUri(metadata as object) as string
        meta = ValidAssociativeArray(metadata)
        uri = ValidString(meta.authorThumbnail)
        if uri = ""
            for each thumbnail in ValidArray(meta.authorThumbnails)
                if IsAssociativeArray(thumbnail)
                    url = ValidString(thumbnail.url)
                    if url <> ""
                        uri = url
                    end if
                end if
            end for
        end if
        if uri = ""
            return "pkg:/images/icons/user-200.png"
        end if
        if uri.StartsWith("//")
            uri = "https:" + uri
        end if
        return uri
    end function

    ' The channel button's options: subscribe/unsubscribe when a profile is signed in, then open the channel.
    function ChannelRows(canSubscribe as boolean, isSubscribed as boolean) as object
        rows = []
        if canSubscribe
            if isSubscribed
                rows.Push({ title: Tr(Locale.Buttons.Unsubscribe), value: "unsubscribe" })
            else
                rows.Push({ title: Tr(Locale.Buttons.Subscribe), value: "subscribe" })
            end if
        end if
        rows.Push({ title: Tr(Locale.ContextMenu.OpenChannel), value: "channel" })
        return rows
    end function

    ' --- Comments overlay rows ---

    ' The comment's meta line: likes · age · the creator-heart marker.
    function CommentMeta(comment as object) as string
        parts = []
        likes = ValidString(comment.likes)
        if likes <> ""
            parts.Push(likes)
        end if
        publishedTime = ValidString(comment.publishedTime)
        if publishedTime <> ""
            parts.Push(publishedTime)
        end if
        if ValidBool(comment.hearted)
            parts.Push(Tr(Locale.PlaybackMenu.HeartedByCreator))
        end if
        return parts.Join(" · ")
    end function

    ' The visible rows of the comments overlay: every comment, its replies while it is expanded, then the
    ' load-more row. Kinds: "comment" (OK toggles its replies), "reply" (inert), "more" (OK loads the next page).
    function CommentRows(comments as object, hasMore as boolean) as object
        rows = []
        if IsArray(comments)
            for i = 0 to comments.Count() - 1
                comment = comments[i]
                if not IsAssociativeArray(comment)
                    continue for
                end if
                rows.Push(CommentRow("comment", i, comment, 0))
                if ValidBool(comment.expanded)
                    for each reply in ValidArray(comment.replyRows)
                        rows.Push(CommentRow("reply", i, reply, 1))
                    end for
                end if
            end for
        end if
        if hasMore
            rows.Push({ kind: "more", commentIndex: -1, author: "", meta: "", text: Tr(Locale.WebApp.LoadMore), indent: 0 })
        end if
        return rows
    end function

    ' One projected row. A comment that has replies says so, with their count, in its meta line, so OK on it is
    ' discoverable.
    function CommentRow(kind as string, commentIndex as integer, comment as object, indent as integer) as object
        meta = CommentMeta(comment)
        if kind = "comment" and ValidString(comment.replyToken) <> ""
            if ValidBool(comment.expanded)
                hint = Tr(Locale.PlaybackMenu.HideReplies)
            else
                hint = Tr(Locale.PlaybackMenu.ViewReplies)
            end if
            replies = ValidString(comment.replies)
            if replies <> ""
                hint = hint + " (" + replies + ")"
            end if
            meta = MetaWith(meta, hint)
        end if
        return {
            kind: kind
            commentIndex: commentIndex
            author: ValidString(comment.author)
            meta: meta
            text: ValidString(comment.text)
            indent: indent
        }
    end function

    function MetaWith(meta as string, part as string) as string
        if meta = ""
            return part
        end if
        return meta + " · " + part
    end function

end namespace
