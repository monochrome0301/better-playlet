<component name="CommentRow" extends="Group">
    <!-- One comment (or reply) of the player's comments overlay. Pure projection of its itemContent
         (author / meta / text / indent). The MarkupList draws the focus highlight behind the focused row, so
         the labels go dark in Repaint to stay readable on it. -->
    <interface>
        <field id="itemContent" type="node" onChange="OnContentSet" />
        <field id="itemHasFocus" type="boolean" onChange="Repaint" />
    </interface>
    <children>
        <EmojiLabel id="authorLabel" translation="[16,6]" width="760" height="30"
            baseFont="font:SmallestBoldSystemFont" baseSize="18" color="0xFEFEFEFF" />
        <Label id="metaLabel" translation="[16,34]" width="760" height="24"
            font="font:SmallestSystemFont" color="0xAAAAAAFF" />
        <EmojiLabel id="textLabel" translation="[16,58]" width="920" height="50"
            baseFont="font:SmallestSystemFont" baseSize="18" color="0xDDDDDDFF" wrap="true" maxLines="3" />
    </children>
</component>
