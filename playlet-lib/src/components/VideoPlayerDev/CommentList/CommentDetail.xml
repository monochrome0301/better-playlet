<component name="CommentDetail" extends="Group" includes="Focus">
    <!-- The player's maximized comment reader: one comment's full text (the list clips it to about three lines),
         with its replies loaded and appended. The text is paginated into a one-column MarkupList — the exact
         mechanics the comments list is built on (native focus + Up/Down paging, EmojiLabel rows that draw emoji),
         so nothing here hand-rolls focus or scrolling. The coordinator owns the data; this component projects it
         and reports Back (closed). -->
    <interface>
        <field id="author" type="string" onChange="OnAuthorSet" />
        <field id="meta" type="string" alias="metaLabel.text" />
        <field id="text" type="string" onChange="OnTextSet" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="scrim" width="1280" height="720" color="0x000000" opacity="0.9" />
        <EmojiLabel id="authorLabel" translation="[80,64]" width="1120" height="44"
            baseFont="font:MediumBoldSystemFont" baseSize="24" color="0xFEFEFEFF" wrap="false" />
        <Label id="metaLabel" translation="[80,112]" width="1120" height="32"
            font="font:SmallestSystemFont" color="0xBBBBBBFF" wrap="false" />
        <!-- drawFocusFeedback off: the default light highlight would turn the whole page into a white slab. -->
        <MarkupList id="pages" translation="[80,164]" itemSize="[1120,470]"
            itemComponentName="CommentDetailPage" numRows="1" vertFocusAnimationStyle="floatingFocus"
            drawFocusFeedback="false" />
    </children>
</component>
