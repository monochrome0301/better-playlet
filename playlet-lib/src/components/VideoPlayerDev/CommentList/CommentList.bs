import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.top.focusable = true
    m.list = m.top.findNode("list")
    m.list.ObserveField("itemSelected", FuncName(OnItemSelected))
    OnStatusSet()
end function

function OnFocusChange() as void
    ' true hands the remote to the list; false releases it, so the player can take focus back.
    NodeSetFocus(m.list, m.top.focus)
end function

function OnCommentsSet() as void
    content = CreateObject("roSGNode", "ContentNode")
    comments = m.top.comments
    if IsArray(comments)
        for each comment in comments
            if not IsAssociativeArray(comment)
                continue for
            end if
            item = content.createChild("ContentNode")
            item.addFields({
                author: ValidString(comment.author)
                meta: ValidString(comment.meta)
                text: ValidString(comment.text)
                indent: ValidInt(comment.indent)
            })
        end for
    end if
    m.list.content = content
    if content.getChildCount() > 0
        m.list.jumpToItem = 0
    end if
end function

function OnFocusIndexSet() as void
    content = m.list.content
    if content <> invalid and content.getChildCount() > 0
        m.list.jumpToItem = m.top.focusIndex
    end if
end function

function OnStatusSet() as void
    label = m.top.findNode("statusLabel")
    status = m.top.status
    label.text = status
    label.visible = status <> ""
end function

function OnItemSelected(event as object) as void
    m.top.selected = { index: event.getData() }
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if
    if key = RemoteKeys.Back
        m.top.closed = true
        return true
    end if
    return false
end function
