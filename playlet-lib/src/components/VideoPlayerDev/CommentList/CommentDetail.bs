import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

' ~how much text one page holds: the reader shows about twenty 1120px-wide lines; the split errs short so a
' page never overflows its row.
const PAGE_CHARS = 1500

function Init()
    m.top.focusable = true
    m.pages = m.top.findNode("pages")
    OnAuthorSet()
end function

function OnAuthorSet() as void
    m.top.findNode("authorLabel").rawText = ValidString(m.top.author)
end function

function OnFocusChange() as void
    ' true hands the remote to the pages list; false releases it, so the player can take focus back.
    NodeSetFocus(m.pages, m.top.focus)
end function

' The full comment split into screen-sized pages. Pure string math — no text measurement: each page takes
' PAGE_CHARS characters, backed up to the nearest space/newline (never below PAGE_FLOOR, so pages stay big)
' so it does not end mid-word unless a single word is huge.
function OnTextSet() as void
    text = ValidString(m.top.text)
    content = CreateObject("roSGNode", "ContentNode")
    index = 1
    while index <= text.Len()
        chunk = text.Mid(index - 1, PAGE_CHARS)
        if index + PAGE_CHARS <= text.Len()
            cut = 0
            for i = PAGE_CHARS - 1 to 200 step -1
                separator = chunk.Mid(i - 1, 1)
                if separator = " " or separator = Chr(10)
                    cut = i
                    exit for
                end if
            end for
            if cut > 0
                chunk = chunk.Left(cut)
            end if
        end if
        page = content.createChild("ContentNode")
        page.addFields({ text: chunk })
        index = index + chunk.Len()
    end while
    m.pages.content = content
    if content.getChildCount() > 0
        m.pages.jumpToItem = 0
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if
    if key = RemoteKeys.Back
        m.top.closed = true
        return true
    end if
    return false
end function
