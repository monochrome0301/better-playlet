<component name="VideoDetails" extends="Group" includes="Focus">
    <!-- The player's video-details overlay: title, the stats line (author/views/likes plus RYD's estimate), the
         paged description and, when YouTube reports one, the game the video is about, with the RYD
         attribution under it. The coordinator owns the data; this component only projects it and reports Back. -->
    <interface>
        <field id="title" type="string" onChange="OnTitleSet" />
        <field id="stats" type="string" alias="statsLabel.text" />
        <field id="description" type="string" onChange="OnDescriptionSet" />
        <field id="links" type="array" onChange="OnLinksSet" />
        <field id="game" type="assocarray" onChange="OnGameSet" />
        <field id="selected" type="assocarray" alwaysNotify="true" />
        <field id="attribution" type="string" alias="attributionLabel.text" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- DeArrow marker: "" hides the poster -->
        <field id="dearrowIcon" type="string" onChange="OnDeArrowIconSet" />
    </interface>
    <children>
        <Rectangle id="scrim" width="1280" height="720" color="0x000000" opacity="0.9" />
        <!-- DeArrow marker, left of the title -->
        <Poster id="dearrowIconPoster" uri="" width="34" height="34" visible="false" translation="[116, 64]" />
        <EmojiLabel id="titleLabel" translation="[160,70]" width="960" height="44" baseFont="font:MediumBoldSystemFont" baseSize="24" color="0xFEFEFEFF" wrap="false" />
        <Label id="statsLabel" translation="[160,116]" width="960" height="32" font="font:SmallestSystemFont" color="0xBBBBBBFF" />
        <!-- One page of the description at a time (Up/Down page it). A Label never draws focus feedback, so the
             dark pane cannot turn into a white slab, and it holds focus only to route the keys to the coordinator. -->
        <EmojiLabel id="descriptionText" translation="[160,166]" width="600" height="480"
            baseFont="font:SmallestSystemFont" baseSize="18" color="0xDDDDDDFF" wrap="true" focusable="true" />
        <Label id="pageLabel" translation="[1060,620]" width="64" height="26"
            font="font:SmallestSystemFont" color="0x888888FF" horizAlign="right" />
        <Label id="linksLabel" translation="[800,166]" width="320" height="28" font="font:SmallestBoldSystemFont" color="0xBBBBBBFF" visible="false" />
        <MarkupList id="linksList" translation="[792,198]" itemSize="[340,54]" itemComponentName="DetailsLinkRow" numRows="7" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <Group id="gameGroup" visible="false">
            <Label id="gameLabel" translation="[160,496]" width="600" height="28" font="font:SmallestBoldSystemFont" color="0xFEFEFEFF" />
            <Poster id="gamePoster" translation="[160,530]" width="80" height="112" loadDisplayMode="scaleToFill" />
            <Label id="gameTitle" translation="[252,530]" width="500" height="32" font="font:SmallBoldSystemFont" color="0xFEFEFEFF" wrap="false" />
            <Label id="gameYear" translation="[252,566]" width="500" height="28" font="font:SmallestSystemFont" color="0xBBBBBBFF" />
        </Group>
        <Label id="attributionLabel" translation="[160,660]" width="960" height="26" font="font:SmallestSystemFont" color="0x888888FF" wrap="false" />
    </children>
</component>
