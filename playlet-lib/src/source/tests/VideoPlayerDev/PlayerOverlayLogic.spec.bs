import "pkg:/components/VideoPlayerDev/PlayerOverlayLogic.bs"

namespace Tests

    @suite
    class PlayerOverlayLogicTests extends Rooibos.BaseTestSuite

        function Metadata(heights as object) as object
            formats = []
            for each height in heights
                formats.Push({ height: height })
            end for
            return { adaptiveFormats: formats }
        end function

        function Titles(options as object) as object
            titles = []
            for each option in options
                titles.Push(option.title)
            end for
            return titles
        end function

        @describe("quality options")

        @it("lists Auto then every distinct height, sharpest first")
        function _()
            options = PlayerOverlayLogic.BuildQualityOptions(m.Metadata([720, 1080, 720, 480]), "auto")
            m.assertEqual(options.Count(), 4)
            m.assertEqual(options[0].value, "auto")
            m.assertEqual(options[0].title, "[x] " + Tr(Locale.Settings.AutoQuality))
            m.assertEqual(options[1].value, "1080p")
            m.assertEqual(options[2].value, "720p")
            m.assertEqual(options[3].value, "480p")
        end function

        @it("marks the selected quality, and auto when there is no override")
        function _()
            options = PlayerOverlayLogic.BuildQualityOptions(m.Metadata([1080, 720]), "720p")
            m.assertEqual(options[2].title, "[x] 720p")

            options = PlayerOverlayLogic.BuildQualityOptions(m.Metadata([1080]), "")
            m.assertEqual(options[0].title, "[x] " + Tr(Locale.Settings.AutoQuality))
        end function

        @it("returns no options when the metadata has no heights (the row is hidden)")
        function _()
            m.assertEqual(PlayerOverlayLogic.BuildQualityOptions(invalid, "auto").Count(), 0)
            m.assertEqual(PlayerOverlayLogic.BuildQualityOptions(m.Metadata([]), "auto").Count(), 0)
        end function

        @describe("track options")

        @it("subtitle options start with Off and mark the selected track")
        function _()
            tracks = [
                { TrackName: "pkg:/a.vtt", Language: "en", Description: "English" }
                { TrackName: "pkg:/b.vtt", Language: "es", Description: "Spanish" }
            ]
            options = PlayerOverlayLogic.BuildSubtitleOptions(tracks, tracks[1])
            m.assertEqual(options.Count(), 3)
            m.assertEqual(options[0].value, "off")
            m.assertEqual(options[0].title, "[  ] " + Tr(Locale.PlaybackMenu.Off))
            m.assertEqual(options[1].title, "[  ] English")
            m.assertEqual(options[2].title, "[x] Spanish")
        end function

        @it("Off is selected when no subtitle track is active")
        function _()
            options = PlayerOverlayLogic.BuildSubtitleOptions([], invalid)
            m.assertEqual(options.Count(), 1)
            m.assertEqual(options[0].title, "[x] " + Tr(Locale.PlaybackMenu.Off))
        end function

        @describe("subtitle appearance options")

        @it("lists the OS caption colors and marks the selected one")
        function _()
            options = PlayerOverlayLogic.BuildCaptionColorOptions("White")
            m.assertEqual(options.Count(), 9)
            m.assertEqual(options[0].value, "Default")
            m.assertEqual(options[1].value, "White")
            m.assertEqual(options[1].title, "[x] White")
            m.assertEqual(options[8].value, "Cyan")
        end function

        @it("lists the background opacities, Off included, and marks the selected one")
        function _()
            options = PlayerOverlayLogic.BuildCaptionOpacityOptions("75%")
            m.assertEqual(options.Count(), 6)
            m.assertEqual(options[0].value, "Default")
            m.assertEqual(options[1].title, "[  ] " + Tr(Locale.PlaybackMenu.Off))
            m.assertEqual(options[4].title, "[x] 75%")
        end function

        @it("the subtitle level's appearance rows show the current values")
        function _()
            rows = PlayerOverlayLogic.SubtitleStyleRows("Yellow", "Black", "75%")
            m.assertEqual(rows.Count(), 3)
            m.assertEqual(rows[0].title, Tr(Locale.PlaybackMenu.TextColor) + ": Yellow")
            m.assertEqual(rows[0].value, PlayerOverlayLogic.Level.SubtitleTextColor)
            m.assertEqual(rows[1].title, Tr(Locale.PlaybackMenu.BackgroundColor) + ": Black")
            m.assertEqual(rows[1].value, PlayerOverlayLogic.Level.SubtitleBackgroundColor)
            m.assertEqual(rows[2].title, Tr(Locale.PlaybackMenu.BackgroundOpacity) + ": 75%")
            m.assertEqual(rows[2].value, PlayerOverlayLogic.Level.SubtitleBackgroundOpacity)
        end function

        @it("audio options mark the selected language and label by Description then Language")
        function _()
            tracks = [
                { TrackName: "a", Language: "en", Description: "English" }
                { TrackName: "b", Language: "es" }
            ]
            options = PlayerOverlayLogic.BuildAudioOptions(tracks, tracks[0])
            m.assertEqual(options.Count(), 2)
            m.assertEqual(options[0].title, "[x] English")
            m.assertEqual(options[1].title, "[  ] es")
        end function

        @describe("main rows")

        @it("includes only the levels that have choices, plus the description and comments shortcuts")
        function _()
            rows = PlayerOverlayLogic.MainRows("Auto", true, "Off", false, "", false, "")
            m.assertEqual(rows.Count(), 3)
            m.assertEqual(rows[0].value, PlayerOverlayLogic.Level.Quality)
            m.assertEqual(rows[1].title, Tr(Locale.PlaybackMenu.VideoDescription))
            m.assertEqual(rows[2].value, "comments")

            rows = PlayerOverlayLogic.MainRows("Auto", false, "Off", true, "English", true, "1.5x")
            m.assertEqual(rows.Count(), 5)
            m.assertTrue(rows[0].title.InStr(Tr(Locale.PlaybackMenu.Subtitles)) = 0)
            m.assertEqual(rows[2].value, PlayerOverlayLogic.Level.Speed)
            m.assertEqual(rows[2].title, Tr(Locale.PlaybackMenu.Speed) + ": 1.5x")
        end function

        @describe("speed options")

        @it("lists YouTube's speeds, Normal for 1x, and marks the current one")
        function _()
            options = PlayerOverlayLogic.BuildSpeedOptions(1.0)
            m.assertEqual(options.Count(), 8)
            m.assertEqual(options[0].value, "0.25")
            m.assertEqual(options[0].title, "[  ] 0.25x")
            m.assertEqual(options[3].title, "[x] " + Tr(Locale.PlaybackMenu.NormalSpeed))
            m.assertEqual(options[7].value, "2")
            m.assertEqual(options[7].title, "[  ] 2x")
        end function

        @it("marks a non-default speed and labels it on the main row")
        function _()
            options = PlayerOverlayLogic.BuildSpeedOptions(1.5)
            m.assertEqual(options[5].title, "[x] 1.5x")
            m.assertEqual(PlayerOverlayLogic.SpeedTextFor(1.25), "1.25x")
            m.assertEqual(PlayerOverlayLogic.SpeedTextFor(1.0), Tr(Locale.PlaybackMenu.NormalSpeed))
        end function

        @describe("video details")

        @it("shows author, views and likes from the backend metadata")
        function _()
            stats = PlayerOverlayLogic.DetailsStats({ author: "@a", viewCount: 1200, likeCount: 12 })
            m.assertTrue(stats.InStr("@a") > -1, "author")
            m.assertTrue(stats.InStr("1.2") > -1, "compact view count")
            m.assertTrue(stats.InStr("12") > -1, "like count")
        end function

        @it("uses YouTube's compact like text when there is no numeric count")
        function _()
            stats = PlayerOverlayLogic.DetailsStats({ viewCount: 10, likeCountText: "1.2K" })
            m.assertTrue(stats.InStr(Tr(Locale.PlaybackMenu.Likes) + ": 1.2K") > -1)
        end function

        @it("adds the Return YouTube Dislike estimate and its attribution")
        function _()
            stats = PlayerOverlayLogic.DetailsStats({ viewCount: 10 }, { dislikes: 521581, rating: 4.5 })
            m.assertTrue(stats.InStr("521") > -1, "compact dislike count")
            m.assertTrue(stats.InStr(Tr(Locale.PlaybackMenu.VideoRating) + ": 4.5/5") > -1, "rating")
            m.assertEqual(PlayerOverlayLogic.DetailsAttribution({ dislikes: 1 }), Tr(Locale.PlaybackMenu.DislikesBy))
            m.assertEqual(PlayerOverlayLogic.DetailsAttribution(invalid), "")
            m.assertFalse(PlayerOverlayLogic.DetailsStats({ viewCount: 10 }).InStr(Tr(Locale.PlaybackMenu.Dislikes)) > -1, "no dislikes without votes")
        end function

        @it("falls back to a no-description message")
        function _()
            m.assertEqual(PlayerOverlayLogic.DetailsDescription(invalid), Tr(Locale.PlaybackMenu.NoDescription))
            m.assertEqual(PlayerOverlayLogic.DetailsDescription({ description: "  " }), Tr(Locale.PlaybackMenu.NoDescription))
            m.assertEqual(PlayerOverlayLogic.DetailsDescription({ description: "Hello" }), "Hello")
        end function

        @it("maps the description links to rows with their type in the text and the raw label kept")
        function _()
            metadata = {
                descriptionLinks: [
                    { kind: "video", id: "vid1", label: "Other video" }
                    { kind: "channel", id: "UCabc", label: "" }
                ]
            }
            rows = PlayerOverlayLogic.DescriptionLinkRows(metadata)

            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].id, "vid1")
            m.assertEqual(rows[0].label, "Other video")
            m.assertEqual(rows[0].text, Tr(Locale.SearchFilters.Video) + ": Other video")
            m.assertEqual(rows[1].text, Tr(Locale.SearchFilters.Channel) + ": UCabc", "the id stands in for a missing label")
            m.assertEqual(PlayerOverlayLogic.DescriptionLinkRows(invalid).Count(), 0)
        end function

        @it("passes the game through when it has a name, otherwise nothing")
        function _()
            game = PlayerOverlayLogic.DetailsGame({ game: { title: "Super Mario World", year: "1990", image: "https://img" } })
            m.assertEqual(game.title, "Super Mario World")
            m.assertEqual(game.year, "1990")
            m.assertEqual(game.image, "https://img")
            m.assertEqual(PlayerOverlayLogic.DetailsGame({ game: { year: "1990" } }), invalid)
            m.assertEqual(PlayerOverlayLogic.DetailsGame(invalid), invalid)
        end function

        @describe("channel button")

        @it("reads the channel id from the metadata, then from the played queue item")
        function _()
            m.assertEqual(PlayerOverlayLogic.ChannelId({ authorId: "UCmeta" }, invalid), "UCmeta")

            content = CreateObject("roSGNode", "Node")
            content.addField("authorId", "string", false)
            content.authorId = "UCcontent"
            m.assertEqual(PlayerOverlayLogic.ChannelId({}, content), "UCcontent")
            m.assertEqual(PlayerOverlayLogic.ChannelId(invalid, content), "UCcontent")
            m.assertEqual(PlayerOverlayLogic.ChannelId(invalid, invalid), "")
        end function

        @it("uses the owner thumbnail, then Invidious's author thumbnails, then the generic user icon")
        function _()
            m.assertEqual(PlayerOverlayLogic.ChannelAvatarUri({ authorThumbnail: "https://a/one.jpg" }), "https://a/one.jpg")
            m.assertEqual(PlayerOverlayLogic.ChannelAvatarUri({ authorThumbnails: [{ url: "https://a/small.jpg" }, { url: "https://a/big.jpg" }] }), "https://a/big.jpg")
            m.assertEqual(PlayerOverlayLogic.ChannelAvatarUri({ authorThumbnails: [{ url: "//a/big.jpg" }] }), "https://a/big.jpg")
            m.assertEqual(PlayerOverlayLogic.ChannelAvatarUri(invalid), "pkg:/images/icons/user-200.png")
        end function

        @it("offers subscribe/unsubscribe only when a profile can subscribe, then open the channel")
        function _()
            rows = PlayerOverlayLogic.ChannelRows(true, false)
            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].title, Tr(Locale.Buttons.Subscribe))
            m.assertEqual(rows[1].title, Tr(Locale.ContextMenu.OpenChannel))

            rows = PlayerOverlayLogic.ChannelRows(true, true)
            m.assertEqual(rows[0].title, Tr(Locale.Buttons.Unsubscribe))
            m.assertEqual(rows[0].value, "unsubscribe")

            rows = PlayerOverlayLogic.ChannelRows(false, false)
            m.assertEqual(rows.Count(), 1)
            m.assertEqual(rows[0].value, "channel")
        end function

        @describe("comment rows")

        function Comment(fields as object) as object
            comment = {
                author: "@a"
                text: "hi"
                likes: "12"
                publishedTime: "2 days ago"
                hearted: false
                replies: ""
                replyToken: ""
                replyRows: []
                expanded: false
            }
            comment.Append(fields)
            return comment
        end function

        @it("projects a comment with likes, age and the creator-heart marker")
        function _()
            rows = PlayerOverlayLogic.CommentRows([m.Comment({ hearted: true })], false)
            m.assertEqual(rows.Count(), 1)
            m.assertEqual(rows[0].kind, "comment")
            m.assertEqual(rows[0].commentIndex, 0)
            m.assertEqual(rows[0].indent, 0)
            m.assertEqual(rows[0].meta, "12 · 2 days ago · " + Tr(Locale.PlaybackMenu.HeartedByCreator))
        end function

        @it("indents replies under their expanded comment, and appends the load-more row")
        function _()
            comments = [
                m.Comment({ replyToken: "t1", expanded: true, replyRows: [m.Comment({ author: "@reply", likes: "" })] })
                m.Comment({ author: "@b" })
            ]
            rows = PlayerOverlayLogic.CommentRows(comments, true)
            m.assertEqual(rows.Count(), 4)
            m.assertEqual(rows[0].kind, "comment")
            m.assertEqual(rows[0].meta.InStr(Tr(Locale.PlaybackMenu.HideReplies)) > 0, true)
            m.assertEqual(rows[1].kind, "reply")
            m.assertEqual(rows[1].commentIndex, 0)
            m.assertEqual(rows[1].indent, 1)
            m.assertEqual(rows[1].author, "@reply")
            m.assertEqual(rows[2].kind, "comment")
            m.assertEqual(rows[3].kind, "more")
        end function

        @it("offers the replies hint only on comments that carry a replies token")
        function _()
            rows = PlayerOverlayLogic.CommentRows([m.Comment({})], false)
            m.assertEqual(rows[0].meta, "12 · 2 days ago")

            rows = PlayerOverlayLogic.CommentRows([m.Comment({ replyToken: "t1" })], false)
            m.assertTrue(rows[0].meta.InStr(Tr(Locale.PlaybackMenu.ViewReplies)) > 0)
        end function

        @it("shows the reply count next to the replies hint")
        function _()
            rows = PlayerOverlayLogic.CommentRows([m.Comment({ replyToken: "t1", replies: "3" })], false)
            m.assertEqual(rows[0].meta, "12 · 2 days ago · " + Tr(Locale.PlaybackMenu.ViewReplies) + " (3)")

            rows = PlayerOverlayLogic.CommentRows([m.Comment({ replyToken: "t1", replies: "3", expanded: true })], false)
            m.assertEqual(rows[0].meta, "12 · 2 days ago · " + Tr(Locale.PlaybackMenu.HideReplies) + " (3)")
        end function

    end class

end namespace
