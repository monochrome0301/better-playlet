import "pkg:/components/Services/Innertube/CommentsEndpoint.bs"

namespace Tests

    @suite
    class CommentsTests extends Rooibos.BaseTestSuite

        function Parse(text as string) as object
            ' bs:disable-next-line NO_PARSE_JSON
            return ParseJson(text)
        end function

        @describe("FindCommentsContinuation")

        @it("takes the token from the watch page's comments section")
        function _()
            payload = m.Parse(`{
                "contents": {"twoColumnWatchNextResults": {"results": {"results": {"contents": [
                    {"itemSectionRenderer": {"sectionIdentifier": "other", "contents": [
                        {"continuationItemRenderer": {"continuationEndpoint": {"continuationCommand": {"token": "wrong"}}}}
                    ]}},
                    {"itemSectionRenderer": {"sectionIdentifier": "comment-item-section", "contents": [
                        {"continuationItemRenderer": {"continuationEndpoint": {"continuationCommand": {"token": "comments-token"}}}}
                    ]}}
                ]}}}}
            }`)
            m.assertEqual(Innertube.FindCommentsContinuation(payload), "comments-token")
        end function

        @it("returns empty when the watch page has no comments section")
        function _()
            payload = m.Parse(`{"contents": {"twoColumnWatchNextResults": {"results": {"results": {"contents": []}}}}}`)
            m.assertEqual(Innertube.FindCommentsContinuation(payload), "")
        end function

        @describe("ParseCommentsResponse")

        @it("reads the count and comments from the modern entity payload")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "k1",
                        "properties": {"content": {"content": "hello world"}, "publishedTime": "2 days ago"},
                        "author": {"displayName": "@author"},
                        "toolbar": {"likeCountNotliked": "12", "replyCount": "3"}
                    }}}
                ]}},
                "onResponseReceivedEndpoints": [
                    {"reloadContinuationItemsCommand": {"continuationItems": [
                        {"commentsHeaderRenderer": {"countText": {"runs": [{"text": "1,234"}, {"text": " Comments"}]}}}
                    ]}},
                    {"reloadContinuationItemsCommand": {"continuationItems": [
                        {"commentThreadRenderer": {"commentViewModel": {"commentViewModel": {"commentKey": "k1"}}}},
                        {"continuationItemRenderer": {"continuationEndpoint": {"continuationCommand": {"token": "next-token"}}}}
                    ]}}
                ]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.count, "1,234")
            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.comments[0].author, "@author")
            m.assertEqual(result.comments[0].text, "hello world")
            m.assertEqual(result.comments[0].likes, "12")
            m.assertEqual(result.comments[0].replies, "3")
            m.assertEqual(result.comments[0].publishedTime, "2 days ago")
            m.assertEqual(result.continuation, "next-token")
        end function

        @it("falls back to the classic commentRenderer")
        function _()
            payload = m.Parse(`{
                "onResponseReceivedEndpoints": [{"reloadContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {"comment": {"commentRenderer": {
                        "authorText": {"simpleText": "@classic"},
                        "contentText": {"runs": [{"text": "hi "}, {"text": "there"}]},
                        "publishedTimeText": {"simpleText": "1 year ago"},
                        "voteCount": {"simpleText": "5"},
                        "replyCount": "2"
                    }}}}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.comments[0].author, "@classic")
            m.assertEqual(result.comments[0].text, "hi there")
            m.assertEqual(result.comments[0].likes, "5")
            m.assertEqual(result.comments[0].replies, "2")
            m.assertEqual(result.continuation, "")
        end function

        @it("reads the creator heart from the toolbar state entity, and the replies token from the thread")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "k1",
                        "properties": {"content": {"content": "hi"}, "publishedTime": "1 day ago"},
                        "author": {"displayName": "@a"},
                        "toolbar": {"likeCountNotliked": "3", "replyCount": "2"}
                    }}},
                    {"payload": {"engagementToolbarStateEntityPayload": {"key": "ts1", "heartState": "TOOLBAR_HEART_STATE_HEARTED"}}}
                ]}},
                "onResponseReceivedEndpoints": [{"reloadContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {
                        "commentViewModel": {"commentViewModel": {"commentKey": "k1", "toolbarStateKey": "ts1"}},
                        "replies": {"contents": [
                            {"continuationItemRenderer": {"button": {"buttonRenderer": {"command": {"continuationCommand": {"token": "replies-token"}}}}}}
                        ]}
                    }}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.comments[0].hearted, true)
            m.assertEqual(result.comments[0].replyContinuation, "replies-token")
        end function

        @it("a comment without the hearted state is not marked, and one with no replies has no token")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "k1",
                        "properties": {"content": {"content": "hi"}},
                        "author": {"displayName": "@a"},
                        "toolbar": {}
                    }}},
                    {"payload": {"engagementToolbarStateEntityPayload": {"key": "ts1", "heartState": "TOOLBAR_HEART_STATE_UNHEARTED"}}}
                ]}},
                "onResponseReceivedEndpoints": [{"reloadContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {"commentViewModel": {"commentViewModel": {"commentKey": "k1", "toolbarStateKey": "ts1"}}}}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments[0].hearted, false)
            m.assertEqual(result.comments[0].replyContinuation, "")
        end function

        @it("reads the replies token from the commentRepliesRenderer wrapper")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "k1",
                        "properties": {"content": {"content": "hi"}},
                        "author": {"displayName": "@a"},
                        "toolbar": {"replyCount": "4"}
                    }}}
                ]}},
                "onResponseReceivedEndpoints": [{"reloadContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {
                        "commentViewModel": {"commentViewModel": {"commentKey": "k1"}},
                        "replies": {"commentRepliesRenderer": {"contents": [
                            {"continuationItemRenderer": {"button": {"buttonRenderer": {"command": {"continuationCommand": {"token": "wrapped-token"}}}}}}
                        ]}}
                    }}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments[0].replies, "4")
            m.assertEqual(result.comments[0].replyContinuation, "wrapped-token")
        end function

        @it("reads a replies page delivered under appendContinuationItemsCommand")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "r1",
                        "properties": {"content": {"content": "a reply"}, "publishedTime": "1 hour ago"},
                        "author": {"displayName": "@rep"},
                        "toolbar": {"likeCountNotliked": "1"}
                    }}}
                ]}},
                "onResponseReceivedEndpoints": [{"appendContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {
                        "commentViewModel": {"commentViewModel": {"commentKey": "r1"}},
                        "replies": {"viewReplies": {"buttonRenderer": {"command": {"continuationCommand": {"token": "more-replies"}}}}}
                    }}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.comments[0].author, "@rep")
            m.assertEqual(result.comments[0].text, "a reply")
            m.assertEqual(result.comments[0].replyContinuation, "more-replies")
        end function

        @it("reads a replies page delivered under appendContinuationItemsAction, as bare view models")
        function _()
            payload = m.Parse(`{
                "frameworkUpdates": {"entityBatchUpdate": {"mutations": [
                    {"payload": {"commentEntityPayload": {
                        "key": "r1",
                        "properties": {"content": {"content": "a reply"}, "publishedTime": "1 hour ago"},
                        "author": {"displayName": "@rep"},
                        "toolbar": {"likeCountNotliked": "1"}
                    }}}
                ]}},
                "onResponseReceivedEndpoints": [{"appendContinuationItemsAction": {"continuationItems": [
                    {"commentViewModel": {"commentKey": "r1"}},
                    {"continuationItemRenderer": {"button": {"buttonRenderer": {"command": {"continuationCommand": {"token": "more-replies"}}}}}}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.comments[0].author, "@rep")
            m.assertEqual(result.comments[0].text, "a reply")
        end function

        @it("reads the classic creator heart and its moreReplies continuation")
        function _()
            payload = m.Parse(`{
                "onResponseReceivedEndpoints": [{"reloadContinuationItemsCommand": {"continuationItems": [
                    {"commentThreadRenderer": {"comment": {"commentRenderer": {
                        "authorText": {"simpleText": "@classic"},
                        "contentText": {"runs": [{"text": "hi"}]},
                        "creatorHeart": {"isHearted": true},
                        "replyCount": "4"
                    }}}}
                ]}}]
            }`)

            result = Innertube.ParseCommentsResponse(payload)

            m.assertEqual(result.comments[0].hearted, true)
            m.assertEqual(result.comments[0].replies, "4")
        end function

    end class

end namespace
